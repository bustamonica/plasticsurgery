# Copy this file to .env.local and fill in your key.
#
# AI provider for generating the "after" preview image.
# Currently supported: "gemini" (Google AI Studio key, model gemini-2.5-flash-image).
# Get a key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Without a key the app still runs in demo mode: the studio works end to end
# but returns the original photo with a "demo" watermark instead of an AI edit.

# The training corpus has 0 extra-high profile pairs and ~1.6% teardrop shape
# pairs, so outputs at those configurator settings are pure extrapolation.
# Both are hidden from the configurator by default; set to "true" once the
# corpus backs them.
NEXT_PUBLIC_ENABLE_UNBACKED_IMPLANT_OPTIONS=
